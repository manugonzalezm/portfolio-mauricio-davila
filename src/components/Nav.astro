---
import { nav, site } from '../data/site';
const actual = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
---
<header class="nav">
  <div class="contenedor nav__fila">
    <a href="/" class="nav__marca">
      <span class="nav__logo" aria-hidden="true"></span>
      <span>{site.nombre}<small>{site.rol}</small></span>
    </a>

    <button class="nav__toggle" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
      <span></span><span></span>
    </button>

    <nav id="menu" class="nav__menu" aria-label="Principal">
      {nav.map((item) => (
        <a href={item.href} aria-current={activo(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('menu');
  btn?.addEventListener('click', () => {
    const abierto = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!abierto));
    btn.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    menu?.classList.toggle('abierto', !abierto);
  });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(244, 239, 232, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--borde);
  }
  .nav__fila { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  .nav__marca { display: flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--font-display); font-size: 1.25rem; line-height: 1.1; }
  .nav__marca small { display: block; font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--texto-suave); }
  .nav__logo {
    width: 30px; height: 30px; background: var(--ladrillo);
    background-image:
      linear-gradient(var(--ladrillo-oscuro) 0 0), linear-gradient(var(--ladrillo-oscuro) 0 0),
      linear-gradient(var(--ladrillo-oscuro) 0 0), linear-gradient(var(--ladrillo-oscuro) 0 0);
    background-size: 100% 2px, 100% 2px, 2px 9px, 2px 9px;
    background-position: 0 9px, 0 19px, 14px 0, 7px 11px;
    background-repeat: no-repeat;
  }
  .nav__menu { display: flex; gap: clamp(1rem, 2.4vw, 2.2rem); }
  .nav__menu a { text-decoration: none; font-size: 0.95rem; font-weight: 500; padding: 6px 0; border-bottom: 2px solid transparent; transition: border-color .2s, color .2s; }
  .nav__menu a:hover { color: var(--ladrillo); }
  .nav__menu a[aria-current='page'] { border-color: var(--ladrillo); color: var(--ladrillo-oscuro); }
  .nav__toggle { display: none; background: none; border: 0; width: 40px; height: 40px; cursor: pointer; padding: 10px 8px; }
  .nav__toggle span { display: block; height: 2px; background: var(--hierro); margin: 6px 0; transition: transform .2s; }
  .nav__toggle[aria-expanded='true'] span:first-child { transform: translateY(4px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }

  @media (max-width: 860px) {
    .nav__toggle { display: block; }
    .nav__menu {
      display: none; position: absolute; top: 76px; left: 0; right: 0;
      flex-direction: column; gap: 0; background: var(--cal);
      border-bottom: 1px solid var(--borde); padding: 0.5rem var(--pad) 1.5rem;
    }
    .nav__menu.abierto { display: flex; }
    .nav__menu a { padding: 0.9rem 0; border-bottom: 1px solid var(--borde); font-size: 1.1rem; }
    .nav__menu a[aria-current='page'] { border-bottom-color: var(--borde); }
  }
</style>
