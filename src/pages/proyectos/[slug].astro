---
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/Imagen.astro';
import TarjetaProyecto from '../../components/TarjetaProyecto.astro';
import { proyectos, type Proyecto } from '../../data/proyectos';

export function getStaticPaths() {
  return proyectos.map((p) => ({ params: { slug: p.slug }, props: { proyecto: p } }));
}

const { proyecto: p } = Astro.props as { proyecto: Proyecto };
const i = proyectos.findIndex((x) => x.slug === p.slug);
const siguiente = proyectos[(i + 1) % proyectos.length];
const galeria = p.imagenes ?? [];
const ficha = [
  ['Ubicación', p.ubicacion],
  ['Año', String(p.anio)],
  ['Tipo', p.categoria],
  ['Superficie', p.superficie],
  ['Estado', p.estado],
];
---
<Base titulo={p.titulo} descripcion={p.resumen}>
  <header class="encabezado-pagina">
    <div class="contenedor">
      <a href="/proyectos/" class="volver">← Proyectos</a>
      <span class="etiqueta">{p.categoria} · {p.anio}</span>
      <h1>{p.titulo}</h1>
      <p class="lead">{p.resumen}</p>
    </div>
  </header>

  <div class="contenedor portada">
    <Imagen src={p.portada} alt={p.titulo} ratio="16 / 9" etiqueta="Foto principal" sizes="100vw" prioridad />
  </div>

  <section class="seccion">
    <div class="contenedor detalle">
      <dl class="ficha">
        {ficha.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        <div>
          <dt>Materiales</dt>
          <dd><ul>{p.materiales.map((m) => <li>{m}</li>)}</ul></dd>
        </div>
      </dl>
      <div class="texto">
        <h2>Título</h2>
        {p.descripcion.map((parrafo) => <p>{parrafo}</p>)}
      </div>
    </div>
  </section>

  <section class="contenedor galeria">
    {galeria.length > 0
      ? galeria.map((src, n) => <Imagen src={src} alt={`${p.titulo}, imagen ${n + 1}`} />)
      : (
        <>
          <Imagen alt="Interior" tono="arena" etiqueta="Interior" />
          <Imagen alt="Detalle constructivo" tono="hierro" etiqueta="Detalle" />
          <div class="ancho"><Imagen alt="Planta" tono="arena" ratio="21 / 9" etiqueta="Plano" /></div>
        </>
      )}
  </section>

  <section class="seccion">
    <div class="contenedor siguiente">
      <span class="etiqueta">Siguiente proyecto</span>
      <div class="siguiente__tarjeta"><TarjetaProyecto proyecto={siguiente} tono="arena" /></div>
    </div>
  </section>
</Base>

<style>
  .volver { display: inline-block; margin-bottom: 2rem; text-decoration: none; color: var(--texto-suave); font-size: .9rem; }
  .volver:hover { color: var(--ladrillo); }
  .portada { margin-top: clamp(2rem, 5vw, 4rem); }
  .detalle { display: grid; grid-template-columns: 320px 1fr; gap: clamp(2rem, 6vw, 6rem); }
  .ficha { margin: 0; border-top: 2px solid var(--hierro); }
  .ficha > div { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--borde); font-size: .95rem; }
  .ficha dt { color: var(--texto-suave); }
  .ficha dd { margin: 0; }
  .ficha ul { margin: 0; padding: 0; list-style: none; }
  .texto { max-width: 62ch; font-size: 1.1rem; }
  .galeria { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .galeria .ancho { grid-column: 1 / -1; }
  .siguiente__tarjeta { max-width: 520px; }
  @media (max-width: 860px) {
    .detalle { grid-template-columns: 1fr; }
    .galeria { grid-template-columns: 1fr; }
  }
</style>
