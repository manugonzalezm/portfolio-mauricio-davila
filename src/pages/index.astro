---
import Base from '../layouts/Base.astro';
import Imagen from '../components/Imagen.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { site } from '../data/site';
import { proyectos } from '../data/proyectos';
import { etapas } from '../data/proceso';

const destacados = proyectos.filter((p) => p.destacada).slice(0, 3);
const principal = destacados[0];
const tonos = ['ladrillo', 'arena', 'hierro'] as const;
---
<Base>
  <section class="hero">
    <div class="contenedor hero__grilla">
      <div class="hero__texto">
        <span class="etiqueta">{site.rol} · {site.ubicacion}</span>
        <h1>Arq. {site.nombre}</h1>
        <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
        <div class="hero__ctas">
          <a href="/proyectos/" class="boton">Ver proyectos</a>
          <a href="/contacto/" class="boton boton--linea">Contactame</a>
        </div>
      </div>
      <a href={`/proyectos/${principal.slug}/`} class="hero__img">
        <Imagen src={principal.portada} alt={principal.titulo} ratio="4 / 5" prioridad etiqueta={`${principal.titulo} · ${principal.anio}`} />
      </a>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="cabecera">
        <div>
          <span class="etiqueta">Proyectos destacados</span>
          <h2>Del plano a la obra</h2>
        </div>
        <a href="/proyectos/" class="link-flecha">Ver todos los proyectos</a>
      </div>
      <div class="grilla-3">
        {destacados.map((p, i) => <TarjetaProyecto proyecto={p} tono={tonos[i % 3]} />)}
      </div>
    </div>
  </section>

  <section class="seccion seccion--arena">
    <div class="contenedor grilla-2">
      <Imagen alt={`Retrato de ${site.nombre}`} tono="ladrillo" ratio="1 / 1" etiqueta="Foto" />
      <div>
        <span class="etiqueta">Sobre mí</span>
        <h2>Hola, soy {site.nombre.split(' ')[0]}.</h2>
        <p class="lead">Escucho antes de dibujar, porque cada espacio tiene que contar la historia de quien lo vive.</p>
        <a href="/sobre-mi/" class="link-flecha">Ver más sobre mí</a>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="cabecera">
        <div>
          <span class="etiqueta">Cómo trabajo</span>
          <h2>Tu idea, construida. Te acompaño en cada etapa</h2>
        </div>
        <a href="/proceso/" class="link-flecha">Ver el proceso completo</a>
      </div>
      <ol class="pasos">
        {etapas.map((e, i) => (
          <li><span class="pasos__n">{String(i + 1).padStart(2, '0')}</span>{e.titulo}</li>
        ))}
      </ol>
    </div>
  </section>

</Base>

<style>
  .hero { padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem); }
  .hero__grilla { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .hero__ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }
  .hero__img { display: block; }
  .cabecera { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .cabecera h2 { margin: 0; }
  .pasos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); border-top: 2px solid var(--hierro); }
  .pasos li { padding: 1.4rem 1.2rem 1.4rem 0; font-family: var(--font-display); font-size: 1.25rem; line-height: 1.2; border-bottom: 1px solid var(--borde); }
  .pasos__n { display: block; font-family: var(--font-body); font-size: .8rem; color: var(--ladrillo); letter-spacing: .1em; margin-bottom: .6rem; }
  @media (max-width: 860px) {
    .hero__grilla { grid-template-columns: 1fr; }
    .hero__img :global(> *) { aspect-ratio: 4 / 3 !important; }
  }
</style>
