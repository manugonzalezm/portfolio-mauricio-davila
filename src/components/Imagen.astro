---
// Muestra una foto optimizada si hay `src`; si no, un placeholder con trama de ladrillo.
//
// `src` es la ruta de la foto DENTRO de src/assets/, por ejemplo:
//   'proyectos/proyecto-01/portada.jpg'
// Astro la convierte automáticamente a AVIF/WebP y genera varios tamaños
// (el navegador baja el que corresponde según la pantalla).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: string;
  alt: string;
  tono?: 'ladrillo' | 'arena' | 'hierro';
  ratio?: string; // ej. '4 / 3', '16 / 9', '3 / 4'
  etiqueta?: string;
  sizes?: string; // qué ancho ocupa la imagen en pantalla
  prioridad?: boolean; // true para la foto principal de la página (carga inmediata)
}
const {
  src, alt, tono = 'ladrillo', ratio = '4 / 3', etiqueta,
  sizes = '(max-width: 860px) 100vw, 50vw', prioridad = false,
} = Astro.props;

const fotos = import.meta.glob<ImageMetadata>('../assets/**/*.{jpg,jpeg,png,webp,avif}', {
  eager: true, import: 'default',
});
const foto = src ? fotos[`../assets/${src}`] : undefined;
if (src && !foto) console.warn(`[Imagen] No se encontró src/assets/${src}`);

const colores = {
  ladrillo: { a: '#B5603F', b: '#9E5236', t: '#F4EFE8' },
  arena: { a: '#D9C6B0', b: '#CBB59C', t: '#1F1D1B' },
  hierro: { a: '#2B2826', b: '#1F1D1B', t: '#D9C6B0' },
}[tono];
const id = `tr-${Math.random().toString(36).slice(2, 8)}`;
---
{foto ? (
  <Picture
    src={foto}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600, 2400].filter((w) => w <= foto.width)}
    sizes={sizes}
    loading={prioridad ? 'eager' : 'lazy'}
    fetchpriority={prioridad ? 'high' : 'auto'}
    style={`aspect-ratio:${ratio};width:100%;height:auto;object-fit:cover;display:block`}
  />
) : (
  <div class="ph" style={`aspect-ratio:${ratio};background:${colores.a}`} role="img" aria-label={`${alt} (imagen pendiente)`}>
    <svg aria-hidden="true" width="100%" height="100%">
      <defs>
        <pattern id={id} width="64" height="44" patternUnits="userSpaceOnUse">
          <rect width="64" height="44" fill={colores.a} />
          <path d="M0 0H64M0 22H64M0 0V22M32 22V44" stroke={colores.b} stroke-width="3" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill={`url(#${id})`} />
    </svg>
    <span style={`background:${colores.a};color:${colores.t}`}>{etiqueta ?? alt}</span>
  </div>
)}

<style>
  .ph { position: relative; width: 100%; overflow: hidden; }
  .ph svg { position: absolute; inset: 0; }
  .ph span {
    position: absolute; left: 14px; bottom: 14px; padding: 4px 10px;
    font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;
  }
</style>
