---
import Base from '../layouts/Base.astro';
---
<Base sinCta titulo="Página no encontrada">
  <section class="seccion">
    <div class="contenedor" style="text-align:center">
      <span class="etiqueta">Error 404</span>
      <h1>Acá falta un ladrillo.</h1>
      <p class="lead" style="margin:0 auto 2rem">La página que buscás no existe o se movió.</p>
      <a href="/" class="boton">Volver al inicio</a>
    </div>
  </section>
</Base>
